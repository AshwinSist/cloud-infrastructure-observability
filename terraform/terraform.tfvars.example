aws_region                 = "ap-southeast-2"
project_name               = "cloud-observability"
vpc_cidr                   = "10.40.0.0/16"
public_subnet_cidr         = "10.40.1.0/24"
private_subnet_cidr        = "10.40.2.0/24"
instance_type              = "c7i-flex.large"
root_volume_size           = 20

# Replace with your own S3 deployment package ARN.
deployment_package_s3_arn  = "arn:aws:s3:::YOUR_BUCKET_NAME/cloud-observability/cloud-observability-deploy.zip"
